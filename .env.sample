# Build-time pins.
# CLAUDE_VERSION / OPENCODE_VERSION (npm `latest`), HERDR_VERSION and
# HERDR_STUDIO_VERSION (GitHub releases) are kept in sync by CI
# (codingenv-rebuild.yml), which bumps this template automatically. Copy it
# to .env locally (gitignored); a local `docker compose build` uses whatever
# is pinned there.
CLAUDE_VERSION=2.1.289
OPENCODE_VERSION=1.18.34
HERDR_VERSION=0.9.3
HERDR_STUDIO_VERSION=0.7.15

# Node.js version baked into the image (official prebuilt binary). Bump and
# rebuild for a newer toolchain; not tracked by CI on purpose.
NODE_VERSION=24.20.0

# Runtime user mapping. Set PUID/PGID to your host user's uid/gid so files the
# sandbox writes into the mounted home are owned by you on the host. 1000:1000
# is the default for the first user on most Linux systems (check yours with `id`).
PUID=1000
PGID=1000

# OpenSSH. SSH_PORT is both the port sshd listens on and the exposed host port
# (connect with `ssh -p 2222 sandbox@<host>`). SSH_PASSWORD_AUTH stays "no"
# (public-key auth via your ~/.ssh/authorized_keys); set to "yes" and give the
# sandbox user a password (`docker compose exec codingenv passwd sandbox`) only
# if you really want password logins.
SSH_PORT=2222
SSH_PASSWORD_AUTH=no

# Runtime toggle for the roamgate web UI auto-start (see README "roamgate web
# UI (auto-started)"; roamgate is formerly herdr-studio/herdr-gui): the
# entrypoint brings up the herdr server and then roamgate on
# 0.0.0.0:HERDR_STUDIO_PORT (run as your mapped user) at
# container start. Set to no to skip both. HERDR_STUDIO_PASSWORD is the
# studio login password (default: sandbox).
HERDR_STUDIO_ENABLED=yes
HERDR_STUDIO_PORT=8787
HERDR_STUDIO_PASSWORD=sandbox

# Global
TZ=Europe/Berlin
